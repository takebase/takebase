/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "takebase-example-global",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_als"],
	// The Firebase project whose ID tokens this Worker accepts. A demo-* project
	// only ever talks to the local Auth emulator; a real deployment sets its own.
	// Emulator trust (TAKEBASE_AUTH_EMULATOR) is never configured here.
	"vars": { "FIREBASE_PROJECT_ID": "demo-takebase" },
	// Local-only identifiers: no remote D1 database is required for development or tests.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "takebase-global",
			"database_id": "local-takebase-global",
			"migrations_dir": "../../../migrations/global"
		}
	],
	// The environment's backup bucket (SEGU-227), which `takebase backup` writes
	// and the admin routes only read. Locally Wrangler persists it with this
	// Worker's state in .wrangler/state.
	"r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "takebase-local-backups" }],
	// Approved staging (SEGU-218): the real Firebase project and a remote D1 in the
	// shared account. Deploy and migrate with the staging:* root scripts.
	"env": {
		"staging": {
			"name": "takebase-staging-global",
			"vars": {
				"FIREBASE_PROJECT_ID": "takebase-eb6e3",
				"CORS_ORIGINS": "https://takebase-staging-app.info8841.workers.dev,https://takebase-staging-admin.pages.dev"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "takebase-staging-global",
					"database_id": "4ff5c14c-f647-4f8b-b5b2-b594a58fe42a",
					"migrations_dir": "../../../migrations/global"
				}
			],
			"r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "takebase-staging-backups" }]
		}
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
