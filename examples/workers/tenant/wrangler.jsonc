/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "takebase-example-tenant",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_als"],
	// One tenant Worker deployment per tenant, each with its own D1 database.
	// Local-only identifiers: no remote D1 database is required for development or tests.
	// Realtime goes to this tenant's own Realtime Database (here the local emulator,
	// one namespace per tenant). The dispatcher user's FIREBASE_DISPATCHER_EMAIL and
	// FIREBASE_DISPATCHER_PASSWORD are secrets only (.dev.vars locally); without them
	// realtime is off and the Worker still serves its API.
	"vars": {
		"TENANT_ID": "local",
		"FIREBASE_DATABASE_URL": "http://127.0.0.1:9000",
		"FIREBASE_API_KEY": "demo-api-key",
		"FIREBASE_DATABASE_NAMESPACE": "demo-takebase-local",
		"TAKEBASE_ENV": "local",
		"DATA_KEY_VERSION": "1"
	},
	// Membership checks go to the global Worker's RPC entrypoint over a service
	// binding, never a configurable URL. Bindings are not inherited by environments.
	"services": [{ "binding": "GLOBAL", "service": "takebase-example-global", "entrypoint": "MembershipEntrypoint" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "takebase-tenant-local",
			"database_id": "local-takebase-tenant-local",
			"migrations_dir": "../../../migrations/tenant"
		}
	],
	// Encrypted secrets (SEGU-223): AES-256-GCM envelopes only, under data key
	// DATA_KEY_V<DATA_KEY_VERSION>, which is a Worker secret, never a var.
	"kv_namespaces": [{ "binding": "SECRETS", "id": "local-takebase-tenant-local-secrets" }],
	"env": {
		"tenant-a": {
			"vars": {
				"TENANT_ID": "tenant-a",
				"FIREBASE_DATABASE_URL": "http://127.0.0.1:9000",
				"FIREBASE_API_KEY": "demo-api-key",
				"FIREBASE_DATABASE_NAMESPACE": "demo-takebase-tenant-a",
				"TAKEBASE_ENV": "local",
				"DATA_KEY_VERSION": "1"
			},
			"services": [{ "binding": "GLOBAL", "service": "takebase-example-global", "entrypoint": "MembershipEntrypoint" }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "takebase-tenant-a",
					"database_id": "local-takebase-tenant-a",
					"migrations_dir": "../../../migrations/tenant"
				}
			],
			"kv_namespaces": [{ "binding": "SECRETS", "id": "local-takebase-tenant-a-secrets" }]
		},
		"tenant-b": {
			"vars": {
				"TENANT_ID": "tenant-b",
				"FIREBASE_DATABASE_URL": "http://127.0.0.1:9000",
				"FIREBASE_API_KEY": "demo-api-key",
				"FIREBASE_DATABASE_NAMESPACE": "demo-takebase-tenant-b",
				"TAKEBASE_ENV": "local",
				"DATA_KEY_VERSION": "1"
			},
			"services": [{ "binding": "GLOBAL", "service": "takebase-example-global", "entrypoint": "MembershipEntrypoint" }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "takebase-tenant-b",
					"database_id": "local-takebase-tenant-b",
					"migrations_dir": "../../../migrations/tenant"
				}
			],
			"kv_namespaces": [{ "binding": "SECRETS", "id": "local-takebase-tenant-b-secrets" }]
		},
		// Approved staging (SEGU-218): each tenant's real Realtime Database and remote
		// D1. FIREBASE_API_KEY and the dispatcher credentials are uploaded as secrets
		// with each deploy (staging:* root scripts), never kept here.
		"staging-tenant-a": {
			"name": "takebase-staging-tenant-a",
			"vars": {
				"TENANT_ID": "tenant-a",
				"FIREBASE_DATABASE_URL": "https://takebase-staging-tenant-a.firebaseio.com",
				"CORS_ORIGINS": "https://takebase-staging-app.info8841.workers.dev,https://takebase-staging-admin.pages.dev",
				"TAKEBASE_ENV": "staging",
				"DATA_KEY_VERSION": "2"
			},
			"services": [{ "binding": "GLOBAL", "service": "takebase-staging-global", "entrypoint": "MembershipEntrypoint" }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "takebase-staging-tenant-a",
					"database_id": "58e47804-aeac-4a53-8c7c-8f84ae823d21",
					"migrations_dir": "../../../migrations/tenant"
				}
			],
			"kv_namespaces": [
				{
					"binding": "SECRETS",
					"id": "7e829120f57142a9a9c87c3d2f35221c"
				}
			]
		},
		"staging-tenant-b": {
			"name": "takebase-staging-tenant-b",
			"vars": {
				"TENANT_ID": "tenant-b",
				"FIREBASE_DATABASE_URL": "https://takebase-staging-tenant-b.firebaseio.com",
				"CORS_ORIGINS": "https://takebase-staging-app.info8841.workers.dev,https://takebase-staging-admin.pages.dev",
				"TAKEBASE_ENV": "staging",
				"DATA_KEY_VERSION": "2"
			},
			"services": [{ "binding": "GLOBAL", "service": "takebase-staging-global", "entrypoint": "MembershipEntrypoint" }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "takebase-staging-tenant-b",
					"database_id": "8d5a7f27-9ab6-42e2-a77b-592a85d07512",
					"migrations_dir": "../../../migrations/tenant"
				}
			],
			"kv_namespaces": [
				{
					"binding": "SECRETS",
					"id": "a50e5974b3b845949f76113d97fdd793"
				}
			]
		}
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
