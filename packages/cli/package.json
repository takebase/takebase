{
	"name": "@takebase/cli",
	"version": "0.0.0",
	"private": true,
	"description": "Takebase command-line interface",
	"type": "module",
	"bin": {
		"takebase": "./src/bin.ts"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"templates"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"prepack": "rm -rf dist && tsc -p tsconfig.build.json"
	},
	"devDependencies": {
		"@takebase/contracts": "workspace:*",
		"@types/node": "^26.6.5"
	},
	"publishConfig": {
		"bin": {
			"takebase": "./dist/bin.js"
		},
		"exports": {
			".": "./dist/index.js"
		}
	}
}
