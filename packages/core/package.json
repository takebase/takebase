{
	"name": "@takebase/core",
	"version": "0.0.0",
	"private": true,
	"description": "Takebase framework core for Cloudflare Workers",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema.ts"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepack": "rm -rf dist && tsc -p tsconfig.build.json"
	},
	"devDependencies": {
		"@types/node": "^26.6.5"
	},
	"dependencies": {
		"@takebase/contracts": "workspace:*",
		"drizzle-orm": "0.45.4",
		"hono": "^4.13.13"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./schema": {
				"types": "./dist/schema.d.ts",
				"default": "./dist/schema.js"
			}
		}
	}
}
