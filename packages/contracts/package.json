{
	"name": "@takebase/contracts",
	"version": "0.0.0",
	"private": true,
	"description": "Takebase HTTP contracts shared by the framework, SDK and CLI",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"prepack": "rm -rf dist && tsc -p tsconfig.build.json"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	}
}
