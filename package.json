{
	"name": "takebase",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.json",
		"test": "pnpm -r --if-present test && vitest run",
		"build": "pnpm -r --if-present build",
		"test:firebase": "firebase emulators:exec --only auth,database --project demo-takebase 'node --test tests/firebase/*.test.ts'",
		"test:realtime": "firebase emulators:exec --only auth,database --project demo-takebase 'pnpm --filter @takebase/adapter-firebase exec vitest run test/emulator.test.ts test/client-emulator.test.ts && pnpm --filter @takebase/example-tenant exec vitest run test/realtime'",
		"dev:stack": "takebase dev --fresh --seed 'node tests/fixtures/seed.ts'",
		"dev:stack:stop": "takebase dev --stop",
		"smoke:diagnostics": "bash tests/smoke/diagnostics.sh",
		"smoke:admin": "bash tests/smoke/admin.sh",
		"test:e2e": "playwright test",
		"e2e:admin": "playwright test tests/e2e/admin-core.spec.ts",
		"journey:admin": "node tests/fixtures/admin-journey.ts",
		"journey:wire": "node tests/fixtures/wire-journey.ts",
		"staging:firebase:setup": "node ops/staging-firebase.ts setup",
		"staging:firebase:rules": "firebase deploy --only database --project takebase-eb6e3 --config ops/.staging/firebase.json",
		"staging:firebase:check": "node ops/staging-firebase.ts check",
		"staging:local:check": "node ops/staging-local.ts",
		"staging:deploy:plan": "takebase deploy --env staging --plan",
		"staging:deploy": "takebase deploy --env staging --confirm staging",
		"staging:check": "takebase doctor --env staging && node ops/staging-cloudflare.ts check",
		"staging:health": "takebase health --env staging",
		"staging:logs": "takebase logs tenant-a --env staging --for 60",
		"staging:seed": "node ops/staging-cloudflare.ts seed",
		"staging:journey": "node ops/staging-cloudflare.ts journey",
		"staging:journey:admin": "node tests/fixtures/admin-journey.ts --env staging",
		"staging:journey:wire": "node tests/fixtures/wire-journey.ts --env staging",
		"staging:e2e": "playwright test --config playwright.staging.config.ts"
	},
	"packageManager": "pnpm@12.15.0",
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@playwright/test": "1.64.1",
		"@takebase/cli": "workspace:*",
		"@takebase/contracts": "workspace:*",
		"@takebase/sdk": "workspace:*",
		"@types/node": "^26.6.5",
		"jsonc-parser": "^3.3.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	}
}
