{
	"name": "takebase",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.json",
		"test": "pnpm -r --if-present test && vitest run",
		"build": "pnpm -r --if-present build",
		"test:firebase": "firebase emulators:exec --only auth,database --project demo-takebase 'node --test tests/firebase/*.test.ts'",
		"test:realtime": "firebase emulators:exec --only auth,database --project demo-takebase 'pnpm --filter @takebase/adapter-firebase exec vitest run test/emulator.test.ts && pnpm --filter @takebase/example-tenant exec vitest run test/realtime'"
	},
	"packageManager": "pnpm@12.15.0",
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@takebase/cli": "workspace:*",
		"@takebase/contracts": "workspace:*",
		"@takebase/sdk": "workspace:*",
		"@types/node": "^26.6.5",
		"jsonc-parser": "^3.3.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	}
}
