# Public Firebase web client configuration — placeholders only.
# These values identify a Firebase project to client SDKs; they are not secrets,
# but never place service-account keys, admin credentials or tokens in this file.
# Copy to firebase/.env (git-ignored) only when a later wave needs a real target.

# Local emulator defaults (demo-* projects never reach real Firebase services).
FIREBASE_PROJECT_ID=demo-takebase
FIREBASE_API_KEY=demo-api-key
FIREBASE_AUTH_DOMAIN=demo-takebase.firebaseapp.com
FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-takebase-default-rtdb
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000

# Real targets are configured only in an explicitly approved remote wave:
# FIREBASE_PROJECT_ID=<real-project-id>
# FIREBASE_API_KEY=<public-web-api-key>
# FIREBASE_AUTH_DOMAIN=<real-project-id>.firebaseapp.com
# FIREBASE_DATABASE_URL=https://<instance>.firebaseio.com
